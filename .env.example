# --- Connexion au Nuki Bridge (reseau local) ---
BRIDGE_HOST=192.168.1.50
BRIDGE_PORT=8080
BRIDGE_TOKEN=change_me
BRIDGE_USE_HTTPS=false

# --- Secu du proxy ---
# Pepper ajoute au hash des cles API avant stockage. Genere-le une fois et
# ne le change plus (sinon toutes les cles existantes deviennent invalides).
API_KEY_PEPPER=change_me_too

# --- Divers ---
POLICIES_PATH=/app/policies.yaml
LOG_LEVEL=info
